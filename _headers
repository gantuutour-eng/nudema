# Cloudflare Pages — HTML-ийг кэшлүүлэхгүй.
# Шинэчлэлт хийхэд хуучин хуудас утсан дээр үлдэхээс сэргийлнэ
# (ялангуяа апп доторх хөтчүүд түрэмгий кэшилдэг).

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

# Cloudflare Pages нь .html хаягийг өргөтгөлгүй .dc хаяг руу шилжүүлдэг.
/*.dc
  Cache-Control: no-cache, must-revalidate

# Runtime ба төлөв өөрчлөгддөг JS
/nudema-store.js
  Cache-Control: no-cache, must-revalidate

/support.js
  Cache-Control: no-cache, must-revalidate

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/nudema-menu.js
  Cache-Control: no-cache, must-revalidate

/nudema-auth.js
  Cache-Control: no-cache, must-revalidate

/auth-page.css
  Cache-Control: no-cache, must-revalidate

/user-ui.js
  Cache-Control: no-cache, must-revalidate

# App metadata and worker updates must not be stuck in a browser cache.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache, must-revalidate

/sw.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

/pwa-install.js
  Cache-Control: no-cache, must-revalidate

/pwa-install.css
  Cache-Control: no-cache, must-revalidate
